@startuml 04-componentes
title Diagrama de componentes del SGR (monolito modular en capas con puertos y adaptadores)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle uml2
skinparam nodesep 40
skinparam ranksep 55

package "SGR (artefacto único sgr: una sola unidad desplegable)" {
  package "Presentación" {
    [Interfaz Web] as UI
  }
  package "Aplicación" {
    [Reloj del Sistema] as CLK
    [Servicio de Acceso] as ACC
    [Planificador] as PLA
    [Servicio de Respaldo] as RESP
    [Gestor de Agentes] as AGE
    [Servicio de Restauración] as REST
    [Servicio de Alertas] as ALE
    [Servicio de Auditoría] as AUD
    [Servicio de Informes] as INF
  }
  package "Puertos (interfaces)" {
    interface "IProveedorNube" as IPN <<puerto>>
    interface "INotificador" as INO <<puerto>>
    interface "IRepositorioDe…" as IRE <<puerto>>
  }
  package "Infraestructura" {
    [Adaptador Acronis] as ADA
    [Notificador por Correo] as NOT
    [Repositorios] as REP
  }
}
database "sgr-db\n(BD SQL)" as DB
cloud "Acronis Cloud" as ACR
cloud "Servicio de correo" as MAIL

UI -down-> ACC
UI -down-> PLA : políticas y\nrespaldo manual
UI -down-> RESP
UI -down-> REST
UI -down-> ALE
UI -down-> AUD
UI -down-> INF
UI -down-> AGE

CLK -down-> PLA : cada minuto
PLA -down-> AGE : obtiene el agente
PLA -down-> RESP
PLA -down-> ALE : alertas y atrasos
PLA -down-> AUD : registra
REST -down-> PLA : respaldo previo
REST -down-> AGE
REST -down-> ALE : restauración fallida
REST -down-> AUD : registra
REST -down-> IPN : simulacros
REST -down-> INO : aviso de resolución
RESP -down-> AGE
RESP -down-> IPN : estrategias
RESP -down-> AUD : registra
ALE -down-> AUD : registra
ACC -down-> AUD : registra
INF -down-> RESP
INF -down-> REST

AGE -down-> IPN : usa
ALE -down-> INO : usa

PLA -down-> IRE
RESP -down-> IRE
REST -down-> IRE
ALE -down-> IRE
AUD -down-> IRE
ACC -down-> IRE
INF -down-> IRE

ADA -up-|> IPN
NOT -up-|> INO
REP -up-|> IRE
NOT -down-> IRE : correos por rol

ADA -down-> ACR : HTTPS (TLS 1.2+)
NOT -down-> MAIL : SMTP sobre TLS
REP -down-> DB : SQL

note right of ADA
  Única pieza que conoce la API
  de Acronis (patrón Adapter).
end note
note right of REP
  Implementa los ocho puertos
  IRepositorioDe… (políticas, tareas,
  puntos, usuarios, alertas,
  auditoría, solicitudes, simulacros).
end note
@enduml
