@startuml 06-clases-nucleo
title Vista 1 – Núcleo de respaldo (Singleton y Multiton)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 50
skinparam class {
  BackgroundColor<<Singleton>> #FFE6CC
  BackgroundColor<<Multiton>> #FFE6CC
  BackgroundColor<<Strategy>> #DDF0DD
  BackgroundColor<<Adapter>> #DDE8F8
  BackgroundColor<<externo>> #EEEEEE
}
hide empty members
class RelojDelSistema {
  + {static} PERIODO_SEG: int = 60
  + tic(ahora: DateTime): void
}
class PlanificadorDeRespaldos <<Singleton>> {
  - {static} instancia: PlanificadorDeRespaldos
  - {static} INTERVALO_ENTRE_REINTENTOS_MIN: int = 1
  - politicas: Map<ServidorOrigen, PoliticaDeRespaldo>
  - gestorDeAlertas: GestorDeAlertas
  - auditoria: ServicioDeAuditoria
  - repoPoliticas: IRepositorioDePoliticas
  - repoTareas: IRepositorioDeTareas
  - repoPuntos: IRepositorioDePuntos
  - PlanificadorDeRespaldos()
  + {static} obtenerInstancia(): PlanificadorDeRespaldos
  + configurar(gestor: GestorDeAlertas, auditoria: ServicioDeAuditoria, repoPoliticas: IRepositorioDePoliticas, repoTareas: IRepositorioDeTareas, repoPuntos: IRepositorioDePuntos): void
  + definirPolitica(politica: PoliticaDeRespaldo, usuario: Usuario, ahora: DateTime): void <<throws ValidacionException, PermisoDenegadoException>>
  + obtenerPolitica(servidor: ServidorOrigen): PoliticaDeRespaldo [0..1]
  + estaProtegido(servidor: ServidorOrigen): boolean
  + recuperarPendientes(ahora: DateTime): void
  + ejecutarCiclo(servidor: ServidorOrigen, ahora: DateTime): TareaDeRespaldo [0..1]
  + lanzarRespaldoManual(servidor: ServidorOrigen, usuario: Usuario, ahora: DateTime): TareaDeRespaldo
  + lanzarRespaldoPrevioARestauracion(servidor: ServidorOrigen, usuario: Usuario, ahora: DateTime): TareaDeRespaldo
  + reintentar(tarea: TareaDeRespaldo, ahora: DateTime): void
  + reanudarEnCola(servidor: ServidorOrigen, ahora: DateTime): void
  + detectarAtrasos(ahora: DateTime): List<Alerta>
  - lanzar(servidor: ServidorOrigen, tipo: TipoDeRespaldo, disparador: TipoDeDisparo, usuario: Usuario [0..1], ahora: DateTime): TareaDeRespaldo
  - procesarResultado(tarea: TareaDeRespaldo, ahora: DateTime): void
}
class AgenteDeRespaldo <<Multiton>> {
  - {static} instancias: Map<ServidorOrigen, AgenteDeRespaldo>
  - servidor: ServidorOrigen
  - tareaEnCurso: TareaDeRespaldo [0..1]
  - inicioUltimoCiclo: DateTime [0..1]
  - ultimoExitoso: DateTime [0..1]
  - fechaUltimoCompleto: DateTime [0..1]
  - fechaUltimoDiferencial: DateTime [0..1]
  - idUltimoCompleto: String [0..1]
  - idUltimoRespaldo: String [0..1]
  - AgenteDeRespaldo(servidor: ServidorOrigen)
  + {static} obtenerInstancia(servidor: ServidorOrigen): AgenteDeRespaldo
  + {static} existeInstancia(servidor: ServidorOrigen): boolean
  + ejecutarRespaldo(tarea: TareaDeRespaldo, ahora: DateTime): void
  + hayRespaldoEnCurso(): boolean
  + registrarInicioDeCiclo(ahora: DateTime): void
  + inicioUltimoCiclo(): DateTime [0..1]
  + restaurar(solicitud: SolicitudDeRestauracion, ahora: DateTime): boolean <<throws SinConexionException>>
  + registrarExito(tarea: TareaDeRespaldo): void
  + ultimoExitoso(): DateTime [0..1]
  + fechaUltimoCompleto(): DateTime [0..1]
  + fechaUltimoDiferencial(): DateTime [0..1]
  + puntoBaseCompleto(): String [0..1]
  + puntoBaseUltimo(): String [0..1]
}
class PoliticaDeRespaldo {
  + {static} INTERVALO_MIN: int = 5
  + {static} INTERVALO_MAX: int = 10
  + {static} INTERVALO_POR_DEFECTO: int = 5
  + {static} RETENCION_MIN_DIAS: int = 7
  + {static} RETENCION_MAX_DIAS: int = 90
  + {static} RETENCION_POR_DEFECTO_DIAS: int = 30
  + {static} HORA_DIFERENCIAL_POR_DEFECTO: LocalTime = 23:00
  + {static} INICIO_HORARIO_LABORAL: LocalTime = 08:00
  + {static} FIN_HORARIO_LABORAL: LocalTime = 18:00
  - servidor: ServidorOrigen
  - intervaloMinutos: int
  - horaDiferencial: LocalTime
  - retencionDias: int
  + PoliticaDeRespaldo(servidor: ServidorOrigen)
  + PoliticaDeRespaldo(servidor: ServidorOrigen, intervaloMinutos: String, retencionDias: String, horaDiferencial: String)
  + validar(): boolean
  + errores(): List<String>
  + {static} esHoraLaboral(hora: LocalTime): boolean
  + cumpleObjetivoDePerdida(): boolean
  + proximaEjecucion(inicioUltimoCiclo: DateTime [0..1], ahora: DateTime): DateTime
  + tipoParaCiclo(agente: AgenteDeRespaldo, ahora: DateTime): TipoDeRespaldo
  + servidor(): ServidorOrigen
  + intervaloMinutos(): int
  + retencionDias(): int
  + horaDiferencial(): LocalTime
}
class TareaDeRespaldo {
  + {static} MAX_REINTENTOS: int = 3
  - id: long
  - servidor: ServidorOrigen
  - tipo: TipoDeRespaldo
  - disparador: TipoDeDisparo
  - estado: EstadoDeTarea
  - creada: DateTime
  - inicio: DateTime [0..1]
  - fin: DateTime [0..1]
  - reintentos: int
  - idRespaldoNube: String [0..1]
  - motivoFallo: String [0..1]
  + TareaDeRespaldo(servidor: ServidorOrigen, tipo: TipoDeRespaldo, disparador: TipoDeDisparo, usuario: Usuario [0..1], ahora: DateTime)
  + iniciar(ahora: DateTime): void
  + marcarVerificando(idRespaldoNube: String): void
  + completar(ahora: DateTime): void
  + registrarFallo(motivo: String, ahora: DateTime): void
  + marcarEnCola(): void
  + puedeReintentar(): boolean
  + estaEnCurso(): boolean
  + estaEnLaNube(): boolean
  + generarPuntoDeRestauracion(retencionDias: int): PuntoDeRestauracion
  + estado(): EstadoDeTarea
  + servidor(): ServidorOrigen
  + tipo(): TipoDeRespaldo
  + idRespaldoNube(): String [0..1]
  + motivoFallo(): String [0..1]
  + fin(): DateTime [0..1]
}
class PuntoDeRestauracion {
  - id: long
  - servidor: ServidorOrigen
  - tipo: TipoDeRespaldo
  - fechaHora: DateTime
  - idRespaldoNube: String
  - verificado: boolean
  - vigenteHasta: DateTime
  + PuntoDeRestauracion(tarea: TareaDeRespaldo, retencionDias: int)
  + estaVigente(ahora: DateTime): boolean
  + esDiario(): boolean
  + servidor(): ServidorOrigen
  + idRespaldoNube(): String
}
interface IEstrategiaDeRespaldo <<Strategy>>
interface IProveedorNube <<Adapter>>
class GestorDeAlertas
class ServicioDeAuditoria
class ValidacionException <<exception>> {
  - errores: List<String>
  + errores(): List<String>
}
class PermisoDenegadoException <<exception>> {
  - mensaje: String
  + mensaje(): String
}
interface IRepositorioDePoliticas {
  + guardar(politica: PoliticaDeRespaldo): void
  + obtener(servidor: ServidorOrigen): PoliticaDeRespaldo [0..1]
}
interface IRepositorioDeTareas {
  + guardar(tarea: TareaDeRespaldo): void
  + pendientes(): List<TareaDeRespaldo>
  + consultar(servidor: ServidorOrigen [0..1], estado: EstadoDeTarea [0..1], desde: DateTime, hasta: DateTime): List<TareaDeRespaldo>
}
interface IRepositorioDePuntos {
  + guardar(punto: PuntoDeRestauracion): void
  + vigentes(servidor: ServidorOrigen, desde: DateTime, hasta: DateTime, soloDiarios: boolean, pagina: int, tamano: int, ahora: DateTime): List<PuntoDeRestauracion>
  + contarVigentes(servidor: ServidorOrigen, desde: DateTime, hasta: DateTime, soloDiarios: boolean, ahora: DateTime): int
}
class Usuario
RelojDelSistema "1" --> "1" PlanificadorDeRespaldos : invoca cada minuto
PlanificadorDeRespaldos "1" --> "0..2" PoliticaDeRespaldo : gestiona
PlanificadorDeRespaldos "1" --> "1" GestorDeAlertas : usa
PlanificadorDeRespaldos "1" --> "1" IRepositorioDePoliticas : guarda políticas en
PlanificadorDeRespaldos "1" --> "1" IRepositorioDeTareas : guarda tareas en
PlanificadorDeRespaldos "1" --> "1" IRepositorioDePuntos : guarda puntos en
PlanificadorDeRespaldos "1" --> "1" ServicioDeAuditoria : usa
AgenteDeRespaldo "1" --> "1" IProveedorNube : proveedor
AgenteDeRespaldo "1" o-- "3" IEstrategiaDeRespaldo : estrategias
AgenteDeRespaldo "1" --> "0..1" TareaDeRespaldo : en curso
TareaDeRespaldo "1" --> "0..1" PuntoDeRestauracion : genera
TareaDeRespaldo "*" --> "0..1" Usuario : lanzada por
PlanificadorDeRespaldos ..> AgenteDeRespaldo : obtiene (Multiton)
PlanificadorDeRespaldos ..> TareaDeRespaldo : crea
PlanificadorDeRespaldos ..> ValidacionException : <<throws>>
PlanificadorDeRespaldos ..> PermisoDenegadoException : <<throws>>
PoliticaDeRespaldo ..> AgenteDeRespaldo : consulta
IEstrategiaDeRespaldo ..> IProveedorNube : usa
GestorDeAlertas "1" --> "1" ServicioDeAuditoria : registra en
note bottom of TareaDeRespaldo
  Se omiten getters triviales que no se usan en los
  diagramas de estados y de secuencia.
end note
note right of PlanificadorDeRespaldos
  configurar(...) se llama una sola vez al arrancar
  el servicio (o desde las pruebas, con dobles);
  después del arranque llama a recuperarPendientes(ahora).
end note
@enduml
